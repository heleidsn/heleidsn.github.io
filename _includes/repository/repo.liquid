{% if include.repository.name %}
  {% assign repo_full_name = include.repository.name %}
  {% assign repo_description = include.repository.description %}
  {% assign repo_tags = include.repository.tags %}
{% else %}
  {% assign repo_full_name = include.repository %}
  {% assign repo_description = '' %}
  {% assign repo_tags = nil %}
{% endif %}

{% assign repo_url = repo_full_name | split: '/' %}
{% assign repo_owner = repo_url[0] %}
{% assign repo_name = repo_url[1] %}

<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ repo_full_name }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card-header">
      <i class="fa-brands fa-github repo-card-icon" aria-hidden="true"></i>
      <div>
        <div class="repo-card-title">{{ repo_name }}</div>
        <div class="repo-card-owner">{{ repo_owner }}</div>
      </div>
    </div>

    {% if repo_description %}
      <p class="repo-card-description">{{ repo_description }}</p>
    {% endif %}

    {% if repo_tags %}
      <div class="repo-card-tags">
        {% for tag in repo_tags %}
          <span>{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </a>
</div>
