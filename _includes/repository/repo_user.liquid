<div class="repo p-2">
  <a class="repo-card repo-card-profile" href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card-header">
      <i class="fa-brands fa-github repo-card-icon" aria-hidden="true"></i>
      <div>
        <div class="repo-card-title">{{ include.username }}</div>
        <div class="repo-card-owner">GitHub Profile</div>
      </div>
    </div>
    <p class="repo-card-description">Selected open-source robotics, autonomous flight, simulation, and reinforcement-learning code.</p>
    <div class="repo-card-tags">
      <span>Robotics</span>
      <span>UAV</span>
      <span>Research Code</span>
    </div>
  </a>
</div>
